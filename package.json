{
	"name": "@protokol/nestjs-template",
	"version": "0.0.1",
	"description": "Protokol Template for Nestjs Framework",
	"contributors": [
		"Žan Kovač <zan@protokol.com>",
		"Amadej Pevec <amadej@protokol.com>",
		"Kristjan Košič <kristjan@protokol.com>"
	],
	"private": true,
	"license": "MIT",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=24.9"
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node --enable-source-maps dist/main",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
		"test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
		"test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config __tests__/e2e/jest-e2e.json",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.ts": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{js,mjs,cjs,json,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.1",
		"@nestjs/platform-express": "^12.0.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nestjs/cli": "^12.0.0",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.13.3",
		"@types/supertest": "^7.2.1",
		"cross-env": "^10.1.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.16.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"husky": "^9.1.7",
		"jest": "^30.5.1",
		"lint-staged": "^17.4.1",
		"prettier": "^3.9.6",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.69.0"
	}
}
