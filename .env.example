# Server port (defaults to 3000).
PORT=3000

# Node environment: development | production | test.
NODE_ENV=

# Comma-separated list of allowed CORS origins.
# Leave empty to allow all origins.
CORS_ORIGINS=

# PostgreSQL connection (matches the docker-compose postgres service).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=protokol
DATABASE_PASSWORD=protokol
DATABASE_NAME=protokol

# SSL: connection to postgres via TLS (true | false).
DATABASE_SSL=false

# Schema auto-creation from entities; bypasses migrations (true | false).
# Intended for local development only. Keep false in production.
DATABASE_SYNCHRONIZE=false
